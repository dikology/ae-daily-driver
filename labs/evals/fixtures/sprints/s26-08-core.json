    {
      "key": "AE-430",
      "id": "10430",
      "fields": {
        "summary": "Spike: can we attribute trial signups to campaign?",
        "status": {
          "name": "Done",
          "statusCategory": {
            "name": "Done"
          }
        },
        "issuetype": {
          "name": "Task"
        },
        "priority": {
          "name": "Medium"
        },
        "assignee": {
          "displayName": "Priya Nair",
          "accountId": "priya.nair"
        },
        "created": "2026-08-10T09:00:00.000+0000",
        "updated": "2026-08-20T15:00:00.000+0000",
        "resolutiondate": "2026-08-21T16:30:00.000+0000",
        "components": [
          {
            "name": "Analysis"
          }
        ],
        "labels": [],
        "description": "Timeboxed to two days. Growth asked whether attribution is feasible with what we already collect.",
        "comment": {
          "comments": [
            {
              "author": {
                "displayName": "Priya Nair",
                "accountId": "priya.nair"
              },
              "created": "2026-08-21T16:25:00.000+0000",
              "updated": "2026-08-21T16:25:00.000+0000",
              "body": "Answer is no. campaign_id is stripped at the CDN edge before the event reaches our collector, so it is absent for 94% of trial signups. Not fixable in the warehouse."
            },
            {
              "author": {
                "displayName": "Marcus Bell",
                "accountId": "marcus.bell"
              },
              "created": "2026-08-21T17:40:00.000+0000",
              "updated": "2026-08-21T17:40:00.000+0000",
              "body": "Growth confirmed: we are deferring the attribution epic to Q4 and will scope a CDN change first. Saved us starting it this quarter."
            }
          ]
        },
        "issuelinks": []
      },
      "changelog": {
        "histories": []
      }
